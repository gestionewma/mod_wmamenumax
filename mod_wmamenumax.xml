                    default="#046aca"
                    format="hex" />
                <field name="top_hover_color_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="top_current_color" type="color"
                    label="MOD_WMAMENUMAX_TOP_CURRENT_COLOR"
