                    max="100"
                    step="1" />
                <field name="mega_bg_color" type="color"
                    label="MOD_WMAMENUMAX_MEGA_BG_COLOR"
                    description="MOD_WMAMENUMAX_MEGA_BG_COLOR_DESC"
                    default="#ffffff"
                    format="hex" />
                <field name="mega_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="top_bg_color" type="color"
                    label="MOD_WMAMENUMAX_TOP_BG_COLOR"
                    description="MOD_WMAMENUMAX_TOP_BG_COLOR_DESC"
                    default="#ffffff"
                    format="hex" />
                <field name="top_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="top_color" type="color"
                    label="MOD_WMAMENUMAX_TOP_COLOR"
                    description="MOD_WMAMENUMAX_TOP_COLOR_DESC"
                    default="#212529"
                    format="hex" />
                <field name="top_color_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
