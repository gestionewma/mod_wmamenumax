                <field name="child_color" type="color"
                    label="MOD_WMAMENUMAX_CHILD_COLOR"
                    description="MOD_WMAMENUMAX_CHILD_COLOR_DESC"
                    default="#212529"
                    format="hex" />
                <field name="child_color_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="child_hover_bg_color" type="color"
                    label="MOD_WMAMENUMAX_CHILD_HOVER_BG_COLOR"
                    description="MOD_WMAMENUMAX_CHILD_HOVER_BG_COLOR_DESC"
                    default="#e9ecef"
                    format="hex" />
                <field name="child_hover_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
            </fieldset>

            <!-- ── Tab Colori Mobile ───────────────────────────────────── -->
            <fieldset name="colors_mobile" label="MOD_WMAMENUMAX_FIELDSET_COLORS_MOBILE">
                <field name="mobile_title_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_TITLE_COLOR"
                    description="MOD_WMAMENUMAX_TITLE_COLOR_DESC"
                    default="#046aca"
                    format="hex" />
                <field name="mobile_title_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mobile_mega_bg_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_MEGA_BG_COLOR"
                    description="MOD_WMAMENUMAX_MEGA_BG_COLOR_DESC"
                    default="#ffffff"
                    format="hex" />
                <field name="mobile_mega_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mobile_top_bg_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_TOP_BG_COLOR"
                    description="MOD_WMAMENUMAX_TOP_BG_COLOR_DESC"
                    default="#ffffff"
                    format="hex" />
                <field name="mobile_top_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mobile_top_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_TOP_COLOR"
                    description="MOD_WMAMENUMAX_TOP_COLOR_DESC"
                    default="#212529"
                    format="hex" />
                <field name="mobile_top_color_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
