<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="6.0" client="site" method="upgrade">
    <name>MOD_WMAMENUMAX</name>
    <author>Team Developer by WMA Web Maker Agency</author>
    <creationDate>20/08/2026</creationDate>
    <copyright>Copyright (C) 2026 Gestionewma. Tutti i diritti riservati.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>wmaextension@gmail.com</authorEmail>
    <authorUrl>https://www.wma.ovh</authorUrl>
    <version>1.0.13</version>
    <description>MOD_WMAMENUMAX_DESCRIPTION</description>
    <namespace path="src">Wma\Module\WmaMenumax</namespace>

    <files>
        <filename module="mod_wmamenumax">mod_wmamenumax.php</filename>
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>forms</folder>
    </files>

    <languages folder="language">
        <language tag="it-IT">it-IT/mod_wmamenumax.ini</language>
        <language tag="it-IT">it-IT/mod_wmamenumax.sys.ini</language>
        <language tag="en-GB">en-GB/mod_wmamenumax.ini</language>
        <language tag="en-GB">en-GB/mod_wmamenumax.sys.ini</language>
    </languages>

    <media destination="mod_wmamenumax" folder="media">
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <config>
        <fields name="params">

            <!-- ── Tab Menu ─────────────────────────────────────────────── -->
            <fieldset name="menu"
                      label="MOD_WMAMENUMAX_FIELDSET_MENU"
                      addfieldprefix="Joomla\Component\Menus\Administrator\Field">
                <field name="menutype" type="menu"
                    label="MOD_WMAMENUMAX_MENUTYPE"
                    description="MOD_WMAMENUMAX_MENUTYPE_DESC"
                    clientid="0" />
                <field name="startLevel" type="number"
                    label="MOD_WMAMENUMAX_STARTLEVEL"
                    description="MOD_WMAMENUMAX_STARTLEVEL_DESC"
                    default="1"
                    min="1"
                    max="10"
                    step="1" />
                <field name="endLevel" type="number"
                    label="MOD_WMAMENUMAX_ENDLEVEL"
                    description="MOD_WMAMENUMAX_ENDLEVEL_DESC"
                    default="0"
                    min="0"
                    max="10"
                    step="1" />
            </fieldset>

            <!-- ── Tab Colonne ──────────────────────────────────────────── -->
            <fieldset name="columns" label="MOD_WMAMENUMAX_FIELDSET_COLUMNS">
                <field name="columns" type="number"
                    label="MOD_WMAMENUMAX_COLUMNS"
                    description="MOD_WMAMENUMAX_COLUMNS_DESC"
                    default="3"
                    min="1"
                    max="5"
                    step="1" />
                <field name="distribution" type="radio"
                    label="MOD_WMAMENUMAX_DISTRIBUTION"
                    description="MOD_WMAMENUMAX_DISTRIBUTION_DESC"
                    class="btn-group btn-group-yesno"
                    default="auto">
                    <option value="auto">MOD_WMAMENUMAX_DISTRIBUTION_AUTO</option>
                    <option value="manual">MOD_WMAMENUMAX_DISTRIBUTION_MANUAL</option>
                </field>
                <field name="col1_count" type="number"
                    label="MOD_WMAMENUMAX_COL1_COUNT"
                    description="MOD_WMAMENUMAX_COL_COUNT_DESC"
                    default="0"
                    min="0"
                    max="100"
                    step="1"
                    showon="distribution:manual" />
                <field name="col2_count" type="number"
                    label="MOD_WMAMENUMAX_COL2_COUNT"
                    description="MOD_WMAMENUMAX_COL_COUNT_DESC"
                    default="0"
                    min="0"
                    max="100"
                    step="1"
                    showon="distribution:manual" />
                <field name="col3_count" type="number"
                    label="MOD_WMAMENUMAX_COL3_COUNT"
                    description="MOD_WMAMENUMAX_COL_COUNT_DESC"
                    default="0"
                    min="0"
                    max="100"
                    step="1"
                    showon="distribution:manual" />
                <field name="col4_count" type="number"
                    label="MOD_WMAMENUMAX_COL4_COUNT"
                    description="MOD_WMAMENUMAX_COL_COUNT_DESC"
                    default="0"
                    min="0"
                    max="100"
                    step="1"
                    showon="distribution:manual" />
                <field name="col5_count" type="number"
                    label="MOD_WMAMENUMAX_COL5_COUNT"
                    description="MOD_WMAMENUMAX_COL_COUNT_DESC"
                    default="0"
                    min="0"
                    max="100"
                    step="1"
                    showon="distribution:manual" />
                <field name="coltitles" type="subform"
                    label="MOD_WMAMENUMAX_COLTITLES"
                    description="MOD_WMAMENUMAX_COLTITLES_DESC"
                    multiple="true"
                    min="0"
                    max="5"
                    layout="joomla.form.field.subform.repeatable-table"
                    formsource="modules/mod_wmamenumax/forms/coltitle.xml"
                    buttons="add,remove,move" />
            </fieldset>

            <!-- ── Tab Colori Desktop ──────────────────────────────────── -->
            <fieldset name="colors_desktop" label="MOD_WMAMENUMAX_FIELDSET_COLORS_DESKTOP">
                <field name="title_color" type="color"
                    label="MOD_WMAMENUMAX_TITLE_COLOR"
                    description="MOD_WMAMENUMAX_TITLE_COLOR_DESC"
                    default="#046aca"
                    format="hex" />
                <field name="title_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mega_border_color" type="color"
                    label="MOD_WMAMENUMAX_MEGA_BORDER_COLOR"
                    description="MOD_WMAMENUMAX_MEGA_BORDER_COLOR_DESC"
                    default="#046aca"
                    format="hex" />
                <field name="mega_border_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mega_outline_color" type="color"
                    label="MOD_WMAMENUMAX_MEGA_OUTLINE_COLOR"
