                    step="1" />
                <field name="mobile_child_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_CHILD_COLOR"
                    description="MOD_WMAMENUMAX_CHILD_COLOR_DESC"
                    default="#212529"
                    format="hex" />
                <field name="mobile_child_color_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
                <field name="mobile_child_hover_bg_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_CHILD_HOVER_BG_COLOR"
                    description="MOD_WMAMENUMAX_CHILD_HOVER_BG_COLOR_DESC"
                    default="#e9ecef"
                    format="hex" />
                <field name="mobile_child_hover_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
                    min="0"
                    max="100"
                    step="1" />
            </fieldset>

            <!-- ── Tab Immagini ─────────────────────────────────────────── -->
            <fieldset name="images" label="MOD_WMAMENUMAX_FIELDSET_IMAGES">
                <field name="thumb_size" type="number"
                    label="MOD_WMAMENUMAX_THUMB_SIZE"
                    description="MOD_WMAMENUMAX_THUMB_SIZE_DESC"
                    default="100"
                    min="50"
                    max="300"
                    step="10" />
                <field name="hover_size" type="number"
                    label="MOD_WMAMENUMAX_HOVER_SIZE"
                    description="MOD_WMAMENUMAX_HOVER_SIZE_DESC"
                    default="400"
                    min="100"
                    max="1200"
                    step="50" />
                <field name="fallback_image" type="media"
                    label="MOD_WMAMENUMAX_FALLBACK_IMAGE"
                    description="MOD_WMAMENUMAX_FALLBACK_IMAGE_DESC" />
            </fieldset>

            <!-- ── Tab Pannello ─────────────────────────────────────────── -->
            <fieldset name="panel" label="MOD_WMAMENUMAX_FIELDSET_PANEL">
                <field name="panel_pct" type="number"
                    label="MOD_WMAMENUMAX_PANEL_PCT"
                    description="MOD_WMAMENUMAX_PANEL_PCT_DESC"
                    default="100"
                    min="1"
                    max="100"
                    step="1" />
            </fieldset>

            <!-- ── Tab SEO ──────────────────────────────────────────────── -->
            <fieldset name="seo" label="MOD_WMAMENUMAX_FIELDSET_SEO">
                <field name="title_tag" type="list"
                    label="MOD_WMAMENUMAX_TITLE_TAG"
                    description="MOD_WMAMENUMAX_TITLE_TAG_DESC"
                    default="h3">
                    <option value="h2">h2</option>
                    <option value="h3">h3</option>
                    <option value="p">p</option>
                    <option value="div">div</option>
                </field>
                <field name="seo_jsonld" type="radio"
                    label="MOD_WMAMENUMAX_SEO_JSONLD"
                    description="MOD_WMAMENUMAX_SEO_JSONLD_DESC"
                    class="btn-group btn-group-yesno"
                    default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>

            <!-- ── Tab Manutenzione ─────────────────────────────────────── -->
            <fieldset name="maintenance"
                      label="MOD_WMAMENUMAX_FIELDSET_MAINTENANCE"
                      addfieldprefix="Wma\Module\WmaMenumax\Site\Field">
                <field name="maintenance" type="WmaMaintenance"
                    label="MOD_WMAMENUMAX_MAINTENANCE"
                    description="MOD_WMAMENUMAX_MAINTENANCE_DESC"
                    hiddenLabel="false" />
            </fieldset>

            <!-- ── Tab Informazioni ─────────────────────────────────────── -->
            <fieldset name="info"
                      label="MOD_WMAMENUMAX_FIELDSET_INFO"
                      addfieldprefix="Wma\Module\WmaMenumax\Site\Field">
                <field name="credits" type="WmaInfo"
                    label="MOD_WMAMENUMAX_FIELDSET_INFO"
                    hiddenLabel="true" />
            </fieldset>

        </fields>
