                    step="1" />
                <field name="mobile_bg_color" type="color"
                    label="MOD_WMAMENUMAX_MOBILE_BG_COLOR"
                    description="MOD_WMAMENUMAX_MOBILE_BG_COLOR_DESC"
                    default="#ffffff"
                    format="hex" />
                <field name="mobile_bg_opacity" type="number"
                    label="MOD_WMAMENUMAX_OPACITY"
                    description="MOD_WMAMENUMAX_OPACITY_DESC"
                    default="100"
